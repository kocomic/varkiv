{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:varkiv:schema:hashpack-record:1",
  "title": "Varkiv HashPack record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sha256",
    "size",
    "platform",
    "game_key",
    "game_default_title",
    "edition_default_title",
    "edition_type",
    "role"
  ],
  "properties": {
    "sha256": { "$ref": "#/$defs/sha256" },
    "size": { "type": "integer", "minimum": 1 },
    "crc32": { "type": "string", "pattern": "^[0-9a-f]{8}$" },
    "md5": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "platform": { "$ref": "#/$defs/nonEmpty" },
    "game_key": { "$ref": "#/$defs/nonEmpty" },
    "game_default_title": { "$ref": "#/$defs/nonEmpty" },
    "game_titles": { "$ref": "#/$defs/titles" },
    "edition_default_title": { "$ref": "#/$defs/nonEmpty" },
    "edition_titles": { "$ref": "#/$defs/titles" },
    "edition_type": { "$ref": "#/$defs/nonEmpty" },
    "version": { "type": "string" },
    "languages": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/nonEmpty" }
    },
    "author": { "type": "string" },
    "region": { "type": "string" },
    "serial": { "type": "string" },
    "product_code": { "type": "string" },
    "title_id": { "type": "string" },
    "role": { "enum": ["rom", "disc", "executable"] },
    "disc_index": {
      "type": "integer",
      "minimum": 0,
      "maximum": 64
    },
    "parent_sha256": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "titles": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/nonEmpty" },
      "additionalProperties": { "$ref": "#/$defs/nonEmpty" }
    }
  }
}
