# Existing absolute directory containing the external ROM collection. It is
# mounted read-only and is never part of Varkiv state backups.
ROM_LIBRARY_PATH=/volume1/games

# Published image tag or digest. Prefer the digest from a tagged GitHub
# Release; use :edge only when intentionally following main.
VARKIV_IMAGE=ghcr.io/owner/repository:edge

# Existing absolute directory on a local ext4/btrfs/ZFS volume. Do not place
# library.db on SMB, CIFS, NFS, SSHFS, or another network filesystem.
VARKIV_DATA_PATH=/volume1/docker/varkiv/data

# Existing private directories outside VARKIV_DATA_PATH. Backup and restore
# drills never overwrite an existing child directory.
VARKIV_BACKUP_PATH=/volume1/backups/varkiv
VARKIV_RESTORE_PATH=/volume1/docker/varkiv/restore-drills

# Generate locally with: openssl rand -hex 32
GAME_LIBRARY_TOKEN=replace-with-a-64-character-random-hex-secret

VARKIV_BIND=0.0.0.0
VARKIV_PORT=8080
TZ=Asia/Shanghai

# Optional pinned EmulatorJS 4.2.3 data directory. When set, include
# compose.web-emulator.yaml in every config/up command.
# EMULATORJS_DATA_PATH=/volume1/docker/varkiv/emulatorjs-4.2.3/data
