# Must be an absolute host path. The container mounts it read-only.
ROM_LIBRARY_PATH=/absolute/path/to/rom-library

# Optional prebuilt image override. The default builds and tags the current
# source tree as varkiv:0.1.0-preview.1.
# VARKIV_IMAGE=registry.example/varkiv:0.1.0-preview.1

# Generate with: openssl rand -hex 32
GAME_LIBRARY_TOKEN=replace-with-a-long-random-secret

VARKIV_BIND=0.0.0.0
VARKIV_PORT=8080
TZ=Asia/Shanghai

# Optional browser player. For a local pinned data/ directory, set the absolute
# host path and start with compose.web-emulator.yaml; that overlay sets the
# container path and a read-only mount. Leave it unset to disable browser play.
# EMULATORJS_DATA_PATH=/absolute/path/to/EmulatorJS/4.2.3/data

# Alternative for resources already hosted by a reverse proxy or fixed HTTPS
# origin. Do not combine this with compose.web-emulator.yaml.
# VARKIV_WEB_EMULATOR_ASSETS=https://cdn.emulatorjs.org/4.2.3/data/

# Optional isolated two-browser NES netplay experiment. Fetch and verify the
# pinned 4.3.0-pre directory first, then add compose.web-netplay.yaml.
# EMULATORJS_NETPLAY_DATA_PATH=/absolute/path/to/EmulatorJS/4.3.0-pre/data
# VARKIV_WEB_NETPLAY_ICE_SERVERS=[]
