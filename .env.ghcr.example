# Published image. Prefer the digest-pinned value included with a tagged
# GitHub Release. Use :edge only when intentionally following main.
VARKIV_IMAGE=ghcr.io/owner/repository:edge

# Existing absolute directory containing the external ROM collection. The
# container mounts it read-only.
ROM_LIBRARY_PATH=/volume1/games

# Existing private directory on a local ext4/btrfs/ZFS volume. Do not place
# library.db on SMB, CIFS, NFS, SSHFS, or another network filesystem.
VARKIV_DATA_PATH=/volume1/docker/varkiv/data

# Generate locally with: openssl rand -hex 32
GAME_LIBRARY_TOKEN=replace-with-a-64-character-random-hex-secret

VARKIV_BIND=0.0.0.0
VARKIV_PORT=8080
TZ=Asia/Shanghai

# Optional fixed HTTPS origin for separately reviewed EmulatorJS assets.
# VARKIV_WEB_EMULATOR_ASSETS=https://example.invalid/emulatorjs/4.2.3/data/

# The experimental netplay overlay is source-distributed and builds its pinned
# signal sidecar locally; its EmulatorJS assets remain a separate read-only mount.
# EMULATORJS_NETPLAY_DATA_PATH=/absolute/path/to/EmulatorJS/4.3.0-pre/data
# VARKIV_WEB_NETPLAY_ICE_SERVERS=[]
